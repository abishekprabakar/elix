# Copy this file to .env and fill in only what you need. Everything is optional.
# With no variables set, Elix runs fully offline with scripted agents.

# Where runtime databases live (elix.db, rails.db, sim_chain.db, sessions.db). Gitignored.
ELIX_DATA_DIR=./data

# offline (default) uses local x402 vendor servers, real signed payloads and simulated settlement.
# live pays real x402 endpoints on Base Sepolia through a facilitator.
ELIX_RAIL_MODE=offline

# Base URL of the x402 vendor servers. The demo starts them on this port.
ELIX_VENDOR_BASE_URL=http://127.0.0.1:8402

# Port the CLI (seed, scenario, eval) uses for the vendor servers. It reuses any vendor server already
# answering there, so give a second copy of Elix its own port and matching base URL above.
ELIX_VENDOR_PORT=8402

# Optional. Where eval/report.json and eval/report.md are written. Defaults to the repo's eval folder.
ELIX_EVAL_DIR=

# Optional. Folder of the built console the API serves. Defaults to console/dist.
ELIX_CONSOLE_DIST=

# Optional. Random seed for the Kestrel Labs history. Defaults to 7.
ELIX_SEED=

# Live mode only. Facilitator that verifies and settles payments on Base Sepolia.
ELIX_FACILITATOR_URL=https://x402.org/facilitator

# Live mode only. Private key of a Base Sepolia TEST wallet funded with testnet USDC.
# Never put a mainnet key here.
ELIX_WALLET_PRIVATE_KEY=

# Live mode only, optional. Coinbase Developer Platform credentials for a CDP server wallet.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Optional. Name of the CDP server wallet account. Defaults to elix-treasury.
ELIX_CDP_ACCOUNT_NAME=

# Set this to run real Claude agents. Without it, scripted agents run and are labeled as such.
ANTHROPIC_API_KEY=

# Model the agents use. Invoice PDFs uploaded on the Reconcile screen are read by the same model when a key is set,
# and by the offline PDF parser otherwise.
ELIX_AGENT_MODEL=claude-sonnet-5-5

# Reserved and not implemented yet. Policy rationales are always template text and numbers are always computed in code.
ELIX_LLM=off

# MCP server only. Which Elix API to call and which agent identity to act as.
ELIX_API_URL=http://127.0.0.1:8400
ELIX_AGENT_TOKEN=tok_scout
